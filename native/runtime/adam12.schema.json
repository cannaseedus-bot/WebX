{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuhul.dev/schemas/adam12-v1.json",
  "title": "ADAM12 Micronaut Artifact",
  "description": "Signed or integrity-addressed declarative semantic field artifact. It contains no executable code.",
  "type": "object",
  "required": ["$schema", "id", "capability", "integrity", "semantic_tensor", "eliza_rules", "hardware_mappings"],
  "properties": {
    "$schema": { "const": "https://kuhul.dev" },
    "id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "integrity": {
      "type": "string",
      "pattern": "^sha256-[A-Fa-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519"] },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "semantic_tensor": {
      "type": "object",
      "required": ["dimensions", "weights", "decay_rate"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": -1, "maximum": 1 }
        },
        "decay_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "eliza_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "pressure_injection"],
        "properties": {
          "match": { "type": "string", "minLength": 1 },
          "pressure_injection": {
            "type": "object",
            "required": ["target", "weight_multiplier"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "weight_multiplier": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "regex_pipeline": {
      "type": "object",
      "required": ["engine", "patterns"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["PCRE2_JIT", "STD_Regex_C11"]
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "match", "mutations"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "match": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "mutations": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["DrawEdge", "InjectPressure", "RouteCapture", "EmitDiagnostic"]
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "toolchain_providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_modes": {
      "type": "object",
      "properties": {
        "use_server": { "type": "boolean" },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "hardware_mappings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
